# ydotool absolute-coordinate scaling for this host.
# Recorded 2026-10-01 via hyprctl cursorpos probes (see
# ~/SilverStone-Hub/skills/ss-remote-screen-control/projects/silverstone-wpal.md).
# Requested (X,Y) lands at (2X,2Y) on this machine -- divide every target by this
# before sending it to ydotool.
YDOTOOL_SCALE_X=2
YDOTOOL_SCALE_Y=2
